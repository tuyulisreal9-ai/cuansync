<?xml version="1.0" encoding="utf-8"?>
<!-- Satu tombol saja. Logo, merek, dan tombol pemasukan sudah dibuang: widget
     ini dipakai sambil berjalan, dan setiap elemen tambahan hanya memperkecil
     target ketuk tanpa mempercepat apa pun.

     Menekannya memunculkan keypad seketika, tanpa membuka aplikasi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cuansync_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_quick_expense"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/cuansync_widget_action_expense"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:minHeight="48dp"
        android:text="@string/widget_record"
        android:textColor="@color/cs_widget_expense_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_quick_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_quick_subtitle"
        android:textColor="@color/cs_widget_text_muted"
        android:textSize="10.5sp" />
</LinearLayout>
