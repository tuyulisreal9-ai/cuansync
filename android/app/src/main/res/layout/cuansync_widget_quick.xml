<?xml version="1.0" encoding="utf-8"?>
<!-- Lihat cuansync_widget_summary.xml: tinggi baris mengikuti isinya supaya
     label tetap utuh ketika pengguna memperbesar ukuran font sistem. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cuansync_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/widget_logo_description"
            android:scaleType="centerInside"
            android:src="@mipmap/ic_launcher_foreground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_brand"
            android:textColor="@color/cs_widget_text"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_quick_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_quick_subtitle"
        android:textColor="@color/cs_widget_text_muted"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_quick_expense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/cuansync_widget_action_expense"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="34dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/widget_expense"
            android:textColor="@color/cs_widget_expense_text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_quick_income"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/cuansync_widget_action_income"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="34dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/widget_income"
            android:textColor="@color/cs_widget_income_text"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
