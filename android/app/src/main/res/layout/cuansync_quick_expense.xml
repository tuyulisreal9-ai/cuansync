<?xml version="1.0" encoding="utf-8"?>
<!-- Layar catat kilat. Sengaja tanpa logo, judul, saldo, atau pemilih
     kategori: yang dibutuhkan hanya nominal dan satu tombol simpan.

     Diletakkan di bawah karena dipakai satu tangan sambil berdiri, dan bagian
     bawah layar yang paling mudah dijangkau ibu jari. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/cuansync_quick_sheet"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/quick_wallet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/cuansync_widget_badge"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:maxWidth="240dp"
        android:minHeight="26dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="@string/quick_wallet_placeholder"
        android:textColor="@color/cs_widget_text_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/quick_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:minHeight="46dp"
        android:text="0"
        android:textColor="@color/cs_widget_text"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/quick_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:minHeight="18dp"
        android:text="@string/quick_hint_category"
        android:textColor="@color/cs_widget_text_faint"
        android:textSize="11.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/quick_key_1" style="@style/CuansyncQuickKey" android:text="1" />
        <TextView android:id="@+id/quick_key_2" style="@style/CuansyncQuickKey" android:text="2" />
        <TextView android:id="@+id/quick_key_3" style="@style/CuansyncQuickKey" android:text="3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/quick_key_4" style="@style/CuansyncQuickKey" android:text="4" />
        <TextView android:id="@+id/quick_key_5" style="@style/CuansyncQuickKey" android:text="5" />
        <TextView android:id="@+id/quick_key_6" style="@style/CuansyncQuickKey" android:text="6" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/quick_key_7" style="@style/CuansyncQuickKey" android:text="7" />
        <TextView android:id="@+id/quick_key_8" style="@style/CuansyncQuickKey" android:text="8" />
        <TextView android:id="@+id/quick_key_9" style="@style/CuansyncQuickKey" android:text="9" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/quick_key_extra" style="@style/CuansyncQuickKey" android:text="000" />
        <TextView android:id="@+id/quick_key_0" style="@style/CuansyncQuickKey" android:text="0" />
        <TextView android:id="@+id/quick_key_back" style="@style/CuansyncQuickKey" android:text="⌫" />
    </LinearLayout>

    <TextView
        android:id="@+id/quick_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/cuansync_quick_save"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:minHeight="52dp"
        android:text="@string/quick_save"
        android:textColor="@color/cs_widget_text"
        android:textSize="15sp" />
</LinearLayout>
