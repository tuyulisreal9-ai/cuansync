<?xml version="1.0" encoding="utf-8"?>
<!-- Tinggi baris sengaja wrap_content dengan minHeight, bukan angka dp mati.
     Ukuran teks memakai sp sehingga ikut membesar mengikuti pengaturan font
     pengguna, sedangkan dp tidak: baris dp tetap membuat nominal terpotong
     begitu pengguna memilih ukuran font Besar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_summary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cuansync_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_summary_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/widget_logo_description"
            android:scaleType="centerInside"
            android:src="@mipmap/ic_launcher_foreground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_brand"
            android:textColor="@color/cs_widget_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_summary_wallet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/cuansync_widget_badge"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="112dp"
            android:minHeight="18dp"
            android:minWidth="50dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/widget_primary_wallet"
            android:textColor="@color/cs_widget_text_muted"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_today"
        android:textColor="@color/cs_widget_text_faint"
        android:textSize="8sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_summary_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_hidden_amount"
            android:textColor="@color/cs_widget_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_summary_detail"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_signed_out_detail"
            android:textColor="@color/cs_widget_text_muted"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_summary_expense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/cuansync_widget_action_expense"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="30dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/widget_expense"
            android:textColor="@color/cs_widget_expense_text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_summary_income"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/cuansync_widget_action_income"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="30dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/widget_income"
            android:textColor="@color/cs_widget_income_text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_summary_transfer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/cuansync_widget_action_transfer"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="30dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/widget_transfer"
            android:textColor="@color/cs_widget_transfer_text"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
