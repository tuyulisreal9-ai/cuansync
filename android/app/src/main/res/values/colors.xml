<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Warna native mengikuti token desain CUANSYNC, bukan palet slate dan
         emerald warisan sebelum redesign. cs_bg_light dan cs_bg_dark bernilai
         sama dengan token latar halaman di styles.css. -->
    <color name="cs_bg_light">#FAF7F1</color>
    <color name="cs_bg_dark">#080D0C</color>
    <color name="cs_ink_light">#211F1B</color>
    <color name="cs_ink_dark">#EEF4F1</color>

    <!-- Splash tetap gelap karena logo CUANSYNC berupa neon bercahaya dengan
         latar transparan; di atas latar terang glow-nya kehilangan kontras. -->
    <color name="cs_splash_bg">#080D0C</color>

    <color name="colorPrimary">#211F1B</color>
    <color name="colorPrimaryDark">#080D0C</color>
    <color name="colorAccent">#211F1B</color>

    <!-- Palet widget sengaja tetap gelap agar identitas dan keterbacaan
         konsisten di atas wallpaper terang maupun gelap. -->
    <color name="cs_widget_background">#101A17</color>
    <color name="cs_widget_surface">#0D1613</color>
    <color name="cs_widget_border">#263832</color>
    <color name="cs_widget_text">#EEF4F1</color>
    <color name="cs_widget_text_muted">#9BAAA5</color>
    <color name="cs_widget_text_faint">#72837D</color>
    <color name="cs_widget_expense_background">#2A181A</color>
    <color name="cs_widget_expense_border">#623039</color>
    <color name="cs_widget_expense_text">#FF9FA8</color>
    <color name="cs_widget_income_background">#123027</color>
    <color name="cs_widget_income_border">#28644F</color>
    <color name="cs_widget_income_text">#7AE6BE</color>
    <color name="cs_widget_transfer_background">#142630</color>
    <color name="cs_widget_transfer_border">#2A586F</color>
    <color name="cs_widget_transfer_text">#8DD8F8</color>
</resources>
