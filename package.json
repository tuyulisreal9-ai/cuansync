{
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "mobile:sync": "pnpm build && cap sync android",
    "mobile:sync:ios": "pnpm build && cap sync ios",
    "mobile:open": "cap open android",
    "mobile:open:ios": "cap open ios",
    "mobile:run": "pnpm mobile:sync && cap run android",
    "mobile:run:ios": "pnpm mobile:sync:ios && cap run ios",
    "mobile:assets": "pnpm mobile:assets:android && pnpm mobile:assets:ios && pnpm mobile:assets:pwa",
    "mobile:assets:android": "capacitor-assets generate --android --assetPath assets-native --iconBackgroundColor \"#080d0c\" --iconBackgroundColorDark \"#080d0c\" --splashBackgroundColor \"#080d0c\" --splashBackgroundColorDark \"#080d0c\" --logoSplashScale 0.18",
    "mobile:assets:ios": "capacitor-assets generate --ios --assetPath assets-native --iconBackgroundColor \"#080d0c\" --iconBackgroundColorDark \"#080d0c\" --splashBackgroundColor \"#080d0c\" --splashBackgroundColorDark \"#080d0c\" --logoSplashScale 0.18",
    "mobile:assets:pwa": "capacitor-assets generate --pwa --assetPath assets",
    "mobile:apk": "pnpm mobile:sync && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "8.0.0",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "8.0.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "2.50.0",
    "@vitejs/plugin-react": "latest",
    "framer-motion": "latest",
    "htm": "^3.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/forms": "0.5.10",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.17"
  }
}
